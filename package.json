{
  "name": "@digitalmedika/satusehat",
  "version": "0.6.1",
  "description": "Type-safe TypeScript wrapper for SATUSEHAT API.",
  "author": "Digital Medika",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalmedika/satusehat.git"
  },
  "bugs": {
    "url": "https://github.com/digitalmedika/satusehat/issues"
  },
  "funding": {
    "url": "https://saweria.co/digitalmedika"
  },
  "homepage": "https://github.com/digitalmedika/satusehat#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:js": "esbuild ./src/index.ts --bundle --format=esm --platform=node --packages=external --outfile=./dist/index.js",
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run build:js && bun run build:types",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "smoke:live": "bun run ./scripts/live-smoke-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun run typecheck && bun test"
  },
  "keywords": [
    "satusehat",
    "kemkes",
    "kemenkes",
    "fhir",
    "hl7-fhir",
    "indonesia",
    "healthcare",
    "typescript",
    "sdk",
    "api-client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/bun": "^1.3.11",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "zod": "^3.24.4"
  }
}
